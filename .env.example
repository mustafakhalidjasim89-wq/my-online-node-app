# Application access (required)
APP_USERNAME=siteadmin
APP_PASSWORD=replace-with-a-long-unique-password
# Generate a long random value; never reuse the example.
SESSION_SECRET=replace-with-a-long-random-session-secret

# Runtime
NODE_ENV=production
PORT=3000
# GPS matching is considered a match only inside this distance (25 to 10000 metres).
GPS_MATCH_DISTANCE_METERS=500

# MongoDB (optional: without this, tickets exist only while the app is running)
MONGO_URI=

# Email dispatch (optional)
EMAIL_USER=
EMAIL_PASS=

# Cloudinary photo upload (optional)
CLOUD_NAME=
API_KEY=
API_SECRET=
